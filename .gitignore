# Python Virtual Environment
venv/
.venv/
env/
ENV/

# Ignore huge Parquet databases and datasets
*.parquet
*.csv

# Ignore compiled python code and cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Ignore binary datasets to avoid github limits
*.mat
*.pdf
*.zip
*.tar.gz
*.pkl

# IDE / Editor configuration
.vscode/
.idea/
*.swp
*.swo
*.user

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables & secrets
.env
.env.local

# Ignore local agent and gemini workspace folders
.agents/
.gemini/
scratch/
*.log

